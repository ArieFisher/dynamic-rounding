.DS_Store
node_modules/
.obsidian/

# Python
__pycache__/
*.egg-info/
*.pyc
.pytest_cache/
dist/
build/

# Local private docs (not committed)
docs/private/

# Claude Code local config / instructions
# CLAUDE.md is tracked (shared repo conventions for Claude sessions).
.claude/

# Antigravity Agent
.agent/*
!.agent/rules/
!.agent/skills/

# Root-level markdown is an allowlist. Every stray that reached this repo was a
# root .md: a scan report, a scratch design doc, a generated PR message. To add
# a root document on purpose, add a negation below.
/*.md
!/README.md
!/CLAUDE.md
!/CONTRIBUTING.md
!/MAINTAINERS.md

# Agent and tool output. Reports about the local toolchain describe the
# developer's machine, not this project, and belong nowhere near a public repo.
*-baseline.md
*_baseline.md
*-report.md
*_report.md
.remember/
.security/

# Credentials
.env
.env.*
*.env
*.pem
*.key
*.p12
*.pfx
id_rsa*
