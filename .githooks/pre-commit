#!/usr/bin/env bash
#
# Blocks a commit that would add a file the repository has no place for, or
# a retired synonym to new prose in any file.
# Enable once per clone:  git config core.hooksPath .githooks
#
set -uo pipefail

repo=$(git rev-parse --show-toplevel)
"$repo/scripts/check-files.sh" --staged || exit 1
exec "$repo/scripts/check-vocab.sh" --staged
