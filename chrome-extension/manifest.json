{
  "manifest_version": 3,
  "name": "Dynamic Rounding",
  "version": "2.5.18",
  "description": "Applies dynamic rounding to tables on arbitrary websites.",
  "permissions": [
    "contextMenus",
    "activeTab",
    "scripting",
    "sidePanel"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "constants.js",
        "lib/dr-log/index.js",
        "lib/dr-number/rounding.js",
        "lib/dr-number/reader.js",
        "lib/dr-number/settings.js",
        "lib/dr-number/numbers-in-text.js",
        "lib/dr-number/dates.js",
        "lib/dr-number/write-back.js",
        "lib/dr-number/identifiers.js",
        "lib/dr-number/index.js",
        "lib/dr-table/cells.js",
        "lib/dr-table/adapters.js",
        "lib/dr-table/classify.js",
        "lib/dr-table/detect.js",
        "lib/dr-table/index.js",
        "lib/dr-simplify/placement.js",
        "lib/dr-simplify/ladder.js",
        "lib/dr-simplify/table.js",
        "lib/dr-capture/state.js",
        "lib/dr-capture/render.js",
        "lib/dr-capture/index.js",
        "app/bus.js",
        "app/model.js",
        "table-pillbox-view.js",
        "toast-view.js",
        "content.js"
      ]
    }
  ],
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "action": {}
}
