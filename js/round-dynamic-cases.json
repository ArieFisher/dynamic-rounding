  {
    "description": "Explicit offset sweep on one value, for cross-implementation formula agreement",
    "cases": [
      {
        "input": 87654321,
        "params": {
          "offset_top": 0
        },
        "expected": 90000000
      },
      {
        "input": 87654321,
        "params": {
          "offset_top": -1
        },
        "expected": 88000000
      },
      {
        "input": 87654321,
        "params": {
          "offset_top": 1
        },
        "expected": 100000000
      },
      {
        "input": 87654321,
        "params": {
          "offset_top": -0.5
        },
        "expected": 90000000
      },
      {
        "input": 87654321,
        "params": {
          "offset_top": 0.5
        },
        "expected": 100000000
      },
      {
        "input": 87654321,
        "params": {
          "offset_top": -1.5
        },
        "expected": 88000000
      },
      {
        "input": 87654321,
        "params": {
          "offset_top": -2.5
        },
        "expected": 87700000
      },
      {
        "input": 87654321,
        "params": {
          "offset_top": 0.25
        },
        "expected": 100000000
      },
      {
        "input": 87654321,
        "params": {
          "offset_top": -0.25
        },
        "expected": 87500000
      }
    ]
