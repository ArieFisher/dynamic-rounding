  {
    "description": "Dataset mode: num_top=1 applies offset_top only to the single largest magnitude",
    "cases": [
      {
        "input": [
          87654321,
          4308910,
          42109,
          1234
        ],
        "params": {
          "offset_top": -1,
          "offset_other": 0,
          "num_top": 1
        },
        "expected": [
          88000000,
          4000000,
          40000,
          1000
        ]
      }
    ]
  },
  {
    "description": "Dataset mode: num_top=2 extends offset_top to the top two magnitudes",
    "cases": [
      {
        "input": [
          87654321,
          4308910,
          42109,
          1234
        ],
        "params": {
          "offset_top": -1,
          "offset_other": 0,
          "num_top": 2
        },
        "expected": [
          88000000,
          4300000,
          40000,
          1000
        ]
      }
    ]
  },
  {
