        "expected_text": "about 1,000 users"
      },
      {
        "input": "up 12345 units",
        "params": {},
        "expected": "up 12345 units",
        "expected_text": "up 10,000 units"
      },
      {
        "input": "Q3 2020",
        "params": {},
        "expected": "Q3 2020",
        "expected_text": "Q3 2,000"
      }
    ]
  },
